@INCLUDE = "@CMAKE_CURRENT_BINARY_DIR@/Doxyfile"

OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/Documentation/DoxygenInternalAudit"
EXTRACT_ALL = NO
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES
HIDE_UNDOC_MEMBERS = NO
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_IF_DOC_ERROR = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC = YES
WARN_AS_ERROR = NO
WARN_LOGFILE = "@CMAKE_CURRENT_BINARY_DIR@/Documentation/DoxygenInternalAudit/warnings.log"

GENERATE_HTML = YES
GENERATE_LATEX = NO
GENERATE_XML = NO
