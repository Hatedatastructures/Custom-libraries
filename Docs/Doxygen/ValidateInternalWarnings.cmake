if(NOT DEFINED WARNINGS_FILE OR NOT EXISTS "${WARNINGS_FILE}")
    message(FATAL_ERROR "Doxygen internal audit warning log is missing")
endif()

file(STRINGS "${WARNINGS_FILE}" WarningLines)
set(UnexpectedWarnings)
set(SuppressedWarnings 0)

foreach(WarningLine IN LISTS WarningLines)
    if(WarningLine MATCHES "warning: return type of member (Protocol::Response|Wan::Network::Agreement::Response)::SetStatusCode is not documented$")
        math(EXPR SuppressedWarnings "${SuppressedWarnings} + 1")
    elseif(WarningLine MATCHES "warning: return type of member (Protocol::Response|Wan::Network::Agreement::Response)::SetStatusMessage is not documented$")
        math(EXPR SuppressedWarnings "${SuppressedWarnings} + 1")
    elseif(WarningLine MATCHES "warning: parameters of member Wan::Web::Executor::~Executor are not documented$")
        math(EXPR SuppressedWarnings "${SuppressedWarnings} + 1")
    else()
        list(APPEND UnexpectedWarnings "${WarningLine}")
    endif()
endforeach()

message(STATUS "Suppressed ${SuppressedWarnings} known void-return/no-parameter warnings")
if(UnexpectedWarnings)
    string(JOIN "\n" WarningText ${UnexpectedWarnings})
    message(FATAL_ERROR "Unexpected Doxygen internal audit warnings:\n${WarningText}")
endif()
