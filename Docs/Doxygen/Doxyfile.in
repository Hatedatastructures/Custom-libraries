PROJECT_NAME = Wan
PROJECT_BRIEF = "C++ 基础组件库"
OUTPUT_DIRECTORY = "@CMAKE_BINARY_DIR@/Documentation/Doxygen"

INPUT = "@CMAKE_CURRENT_SOURCE_DIR@/Wan" \
        "@CMAKE_CURRENT_SOURCE_DIR@/Include"
FILE_PATTERNS = *.hpp *.h *.cpp
RECURSIVE = YES
INPUT_ENCODING = UTF-8

EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO
BUILTIN_STL_SUPPORT = YES
HIDE_UNDOC_MEMBERS = NO
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_IF_DOC_ERROR = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR = FAIL_ON_WARNINGS
WARN_LOGFILE = "@CMAKE_BINARY_DIR@/Documentation/Doxygen/warnings.log"

GENERATE_HTML = YES
HTML_OUTPUT = html
GENERATE_LATEX = NO
MARKDOWN_SUPPORT = YES
GENERATE_TREEVIEW = YES
SOURCE_BROWSER = YES
JAVADOC_AUTOBRIEF = YES
